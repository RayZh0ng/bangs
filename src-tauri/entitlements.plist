<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Asking Spotify what it is playing, and telling it to play or skip.
       The hardened runtime refuses Apple Events without this, so a notarized
       build would silently lose the Spotify panel. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
